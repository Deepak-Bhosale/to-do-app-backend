{
  "name": "to-do-app-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "tsc-watch --project . --onSuccess \"npm run nodemon\"",
    "nodemon": "nodemon ./dist/index.js",
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "test": "jest --detectOpenHandles",
    "test:c": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "dist"
    ],
    "setupFiles": [
      "dotenv/config"
    ],
    "verbose": true,
    "collectCoverageFrom": [
      "src/**/**/*.ts",
      "!**/node_modules/**",
      "!**/vendor/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 50,
        "statements": 50
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/node": "^7.25.0",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.24.7",
    "@google-cloud/secret-manager": "^5.6.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/lodash": "^4.17.7",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^22.5.4",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "commitizen": "^4.3.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "google-auth-library": "^9.14.1",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "lint-staged": "^15.2.10",
    "mongodb": "^6.8.1",
    "mongodb-memory-server": "^10.0.0",
    "mongoose": "^8.6.2",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.4",
    "router": "^1.3.8",
    "sandbox": "^0.8.6",
    "supertest": "^7.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "^29.2.5",
    "tsc-watch": "^6.2.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "airbnb": "^0.0.2",
    "cors": "^2.8.5",
    "lodash": "^4.17.21",
    "octokit": "^4.0.2",
    "ws": "^8.18.0"
  }
}